{
  "description": "Static analysis and code quality enforcement hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook-write-code.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
